// Букви, които приличат на латински - печатат се с латинския код
char lookalike(unsigned int cp) {
  switch (cp) {
    case 0x0410: return 'A'; case 0x0412: return 'B'; case 0x0415: return 'E';
    case 0x041A: return 'K'; case 0x041C: return 'M'; case 0x041D: return 'H';
    case 0x041E: return 'O'; case 0x0420: return 'P'; case 0x0421: return 'C';
    case 0x0422: return 'T'; case 0x0425: return 'X';
    case 0x0430: return 'a'; case 0x0432: return 'B'; case 0x0435: return 'e';
    case 0x043A: return 'K'; case 0x043C: return 'M'; case 0x043D: return 'H';
    case 0x043E: return 'o'; case 0x0440: return 'p'; case 0x0441: return 'c';
    case 0x0442: return 'T'; case 0x0443: return 'y'; case 0x0445: return 'x';
  }
  return 0;
}

int findGlyph(unsigned int cp) {
  for (int i = 0; i < GLYPH_COUNT; i++) {
    if (pgm_read_word(&GLYPH_CP[i]) == cp) return i;
  }
  return -1;
}

// Показва два реда руски текст (UTF-8) върху дисплея
void showRu(const char *l1, const char *l2) {
  byte out[2][16];
  byte slotIdx[8];
  unsigned int slotCp[8];
  byte n = 0;
  const char *lines[2] = { l1, l2 };

  for (byte r = 0; r < 2; r++) {
    const char *p = lines[r];
    byte col = 0;
    while (*p && col < 16) {
      unsigned int cp = (byte)*p++;
      if (cp >= 0x80) {                       // UTF-8 -> Unicode
        if ((cp & 0xE0) == 0xC0 && *p) {
          cp = ((cp & 0x1F) << 6) | ((byte)*p++ & 0x3F);
        } else {
          while (*p && (((byte)*p) & 0xC0) == 0x80) p++;
          cp = '?';
        }
      }
      byte code;
      if (cp < 0x80) {
        code = (byte)cp;
      } else {
        char la = lookalike(cp);
        if (la) {
          code = (byte)la;
        } else {
          int gi = findGlyph(cp);
          if (gi < 0) {
            code = '?';
          } else {
            int slot = -1;
            for (byte i = 0; i < n; i++) {
              if (slotCp[i] == cp) { slot = i; break; }
            }
            if (slot < 0 && n < 8) {
              slotCp[n] = cp;
              slotIdx[n] = (byte)gi;
              slot = n;
              n++;
            }
            code = (slot < 0) ? '?' : (byte)slot;
          }
        }
      }
      out[r][col++] = code;
    }
    while (col < 16) out[r][col++] = ' ';
  }

  // 1) зареждаме рисуваните букви в CGRAM
  for (byte i = 0; i < n; i++) {
    byte bmp[8];
    for (byte j = 0; j < 8; j++) bmp[j] = pgm_read_byte(&GLYPH_BMP[slotIdx[i]][j]);
    lcd.createChar(i, bmp);
  }
  // 2) печатаме двата реда
  for (byte r = 0; r < 2; r++) {
    lcd.setCursor(0, r);
    for (byte c = 0; c < 16; c++) lcd.write(out[r][c]);
  }
}

void setup() {
  lcd.begin(16, 2);
  lcd.clear();
}

void loop() {
  showRu("Привет, мир!", "Arduino Mega");
  delay(3000);
  showRu("Температура", "23.5 C");
  delay(3000);
  showRu("Давление", "Всё работает!");
  delay(3000);

  // Тест на рисуваните букви (до 8 различни на екран)
  showRu("БГДЁЖЗИЙ", "TEST 1/6");  delay(3000);
  showRu("ЛПУФЦЧШЩ", "TEST 2/6");  delay(3000);
  showRu("ЪЫЬЭЮЯ",   "TEST 3/6");  delay(3000);
  showRu("бгдёжзий", "TEST 4/6");  delay(3000);
  showRu("лпфцчшщъ", "TEST 5/6");  delay(3000);
  showRu("ыьэюя",    "TEST 6/6");  delay(3000);
}
