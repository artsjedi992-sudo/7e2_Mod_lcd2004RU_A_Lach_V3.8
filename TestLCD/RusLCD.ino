// Руски текст на стандартен LCD 1602 (HD44780) с Arduino Mega 2560 - всичко в един файл.
//
// Свързване:
//   LCD 1 VSS->GND, 2 VDD->5V, 3 V0->среден извод на тример 10k (контраст)
//   LCD 4 RS->D8, 5 RW->GND, 6 E->D9
//   LCD 11 D4->D10, 12 D5->D11, 13 D6->D12, 14 D7->D13
//   LCD 15 A->5V (през ~220 Ом), 16 K->GND
//
// Забележка: на един екран (двата реда заедно) може да има най-много 8
// различни "рисувани" букви. Излишните се показват като '?'.

#include <LiquidCrystal.h>
#include <avr/pgmspace.h>

LiquidCrystal lcd(8, 9, 10, 11, 12, 13);   // RS, E, D4, D5, D6, D7

#define GLYPH_COUNT 43

